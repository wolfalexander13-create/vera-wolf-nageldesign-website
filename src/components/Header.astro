---
const navItems = [
  { href: '#ueber-mich', label: 'Über mich' },
  { href: '#leistungen', label: 'Leistungen' },
  { href: '#preise', label: 'Preise' },
  { href: '#wissen', label: 'Nagel-Lexikon' },
  { href: '#referenzen', label: 'Referenzen' },
  { href: '#kontakt', label: 'Kontakt' },
];
---

<header class="site-header" id="site-header">
  <div class="site-header__bar wrap">
    <a href="#start" class="site-header__brand">
      <span class="site-header__brand-name">Vera Wolf</span>
      <span class="site-header__brand-sub">Nageldesign</span>
    </a>

    <nav class="site-header__nav" aria-label="Hauptnavigation" id="primary-nav">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="#kontakt" class="btn btn--primary btn--small">Termin buchen</a>
      <button
        type="button"
        class="site-header__toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span class="sr-only">Menü öffnen</span>
        <span class="site-header__toggle-bar"></span>
        <span class="site-header__toggle-bar"></span>
        <span class="site-header__toggle-bar"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(251, 246, 241, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line-soft);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  .site-header__brand {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    text-decoration: none;
    color: var(--color-ink);
  }

  .site-header__brand-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
  }

  .site-header__brand-sub {
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-top: 0.15rem;
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-header__nav a {
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    transition: color 0.2s ease;
    position: relative;
  }

  .site-header__nav a:hover {
    color: var(--color-primary);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__actions .btn--small {
    display: none;
  }

  .site-header__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-s);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    cursor: pointer;
  }

  .site-header__toggle-bar {
    width: 18px;
    height: 2px;
    background: var(--color-ink);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 899px) {
    .site-header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-line-soft);
      box-shadow: var(--shadow-card);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .site-header__nav.is-open {
      max-height: 26rem;
    }

    .site-header__nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.5rem;
    }

    .site-header__nav li {
      width: 100%;
      border-bottom: 1px solid var(--color-line-soft);
    }

    .site-header__nav a {
      display: block;
      padding: 0.9rem 0.1rem;
    }
  }

  @media (min-width: 900px) {
    .site-header__nav {
      display: block;
    }
    .site-header__actions .btn--small {
      display: inline-flex;
    }
    .site-header__toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
