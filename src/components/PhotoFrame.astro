---
// Wiederverwendbarer Bild-Rahmen mit elegantem Platzhalter-Zustand.
// Sobald unter `src` eine echte Datei mit exakt diesem Namen abgelegt wird,
// ersetzt sie automatisch den Platzhalter (kein Code-Änderung nötig).
interface Props {
  src: string;
  alt: string;
  label: string;
  ratio?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
}

const {
  src,
  alt,
  label,
  ratio = '4 / 5',
  class: klass,
  loading = 'lazy',
  sizes,
} = Astro.props;

const filename = src.split('/').pop();
---

<figure class={`photo-frame ${klass ?? ''}`} style={`aspect-ratio:${ratio}`}>
  <span class="photo-frame__placeholder" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <circle cx="9" cy="10" r="2" />
      <path d="m4 18 5-5 3 3 5-6 3 4" />
    </svg>
    <span class="photo-frame__label">{label}</span>
    <span class="photo-frame__filename">{filename}</span>
  </span>
  <img
    src={src}
    alt={alt}
    loading={loading}
    decoding="async"
    sizes={sizes}
    onerror="this.style.display='none'"
  />
</figure>
