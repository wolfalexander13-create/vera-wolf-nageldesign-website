---
import { site } from '../data/site';
import { withBase } from '../utils/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <span class="site-footer__name">Vera Wolf Nageldesign</span>
      <p>{site.tagline}</p>
    </div>

    <div class="site-footer__col">
      <h2>Kontakt</h2>
      <ul>
        <li>{site.address.street}</li>
        <li>{site.address.zip} {site.address.city}</li>
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={site.emailHref}>{site.email}</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2>Navigation</h2>
      <ul>
        <li><a href="#leistungen">Leistungen</a></li>
        <li><a href="#preise">Preise</a></li>
        <li><a href="#wissen">Nagel-Lexikon</a></li>
        <li><a href="#kontakt">Kontakt</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2>Rechtliches</h2>
      <ul>
        <li><a href={withBase('/impressum/')}>Impressum</a></li>
        <li><a href={withBase('/datenschutz/')}>Datenschutz</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__bottom">
    <p>&copy; {year} Vera Wolf Nageldesign · March-Hugstetten bei Freiburg im Breisgau</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: rgba(255, 255, 255, 0.78);
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .site-footer h2 {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1.1rem;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .site-footer__brand .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: #fff;
  }

  .site-footer__brand p {
    margin-top: 0.6rem;
    max-width: 26ch;
    color: rgba(255, 255, 255, 0.6);
    font-style: italic;
    font-family: var(--font-display);
  }

  .site-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .site-footer__col a {
    text-decoration: none;
    color: inherit;
  }

  .site-footer__col a:hover {
    color: var(--color-accent);
  }

  .site-footer__bottom {
    padding-block: 1.5rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
  }

  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }
</style>
