---
import { glossary } from '../data/glossary';
---

<section id="wissen" class="glossary section-pad">
  <div class="wrap">
    <div class="section-head section-head--center">
      <p class="eyebrow">Nagel-Lexikon</p>
      <h2 class="section-title">Fachbegriffe, verständlich erklärt</h2>
      <p class="section-lede">
        Was steckt hinter Russischer Maniküre, Gel-X oder No-File? Hier
        erfahren Sie, was die jeweilige Technik ausmacht — und welchen
        konkreten Vorteil sie gegenüber einer klassischen Modellage bietet.
      </p>
    </div>

    <div class="glossary__list">
      {
        glossary.map((entry, index) => (
          <details class="glossary-item" id={`glossar-${entry.slug}`} open={index === 0}>
            <summary>
              <span class="glossary-item__term">{entry.term}</span>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" class="glossary-item__chevron">
                <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="glossary-item__body">
              <p><strong>Was ist das?</strong> {entry.what}</p>
              <p><strong>Die Technik:</strong> {entry.technique}</p>
              <p class="glossary-item__advantage">
                <strong>Der Vorteil:</strong> {entry.advantage}
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .glossary {
    background: var(--color-surface);
  }

  .glossary__list {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .glossary-item {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    padding: 1.3rem 1.5rem;
    background: var(--color-bg);
  }

  .glossary-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .glossary-item summary::-webkit-details-marker {
    display: none;
  }

  .glossary-item__chevron {
    flex-shrink: 0;
    color: var(--color-primary);
    transition: transform 0.25s ease;
  }

  .glossary-item[open] .glossary-item__chevron {
    transform: rotate(180deg);
  }

  .glossary-item__body {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-line-soft);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: 0.94rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .glossary-item__body strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  .glossary-item__advantage {
    padding: 0.85rem 1rem;
    background: var(--color-accent-pale);
    border-radius: var(--radius-s);
    border-left: 3px solid var(--color-primary);
  }
</style>
