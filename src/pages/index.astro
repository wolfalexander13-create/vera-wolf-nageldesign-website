---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { pricingCategories } from '../data/pricing';
import { certificates } from '../data/certificates';
import { portfolio } from '../data/portfolio';
import { withBase } from '../utils/url';

const title = 'Wolf Clawz Nail Design by Vera, Nagelstudio in March bei Freiburg';
const description =
  'Gel-X, Modellage und russische Maniküre mit MMA-freien Produkten. Nagelstudio von Vera in March-Hugstetten bei Freiburg.';

const services = [
  { name: 'Gel-X', line: 'Verlängerung mit Soft-Gel-Tips, geklebt statt gefräst.' },
  { name: 'Russische Maniküre', line: 'Trocken, mit feinem Fräser, sauber bis an die Nagelhaut.' },
  { name: 'Gel-Modellage', line: 'Neuset oder Auffüllen, in der Form Ihrer Wahl.' },
  { name: 'Naturnagelpflege', line: 'Aufbau und Stärkung für dünne, brüchige Nägel.' },
  { name: 'Press-Ons', line: 'Handgefertigte Sets in Ihrer Größe, wiederverwendbar.' },
];

const shapes = [
  { name: 'Russische Mandel', line: 'Schmal zulaufend, elegant im Alltag.', d: 'M22 170 L22 82 C22 46 40 16 50 10 C60 16 78 46 78 82 L78 170 Q50 196 22 170 Z' },
  { name: 'Stiletto', line: 'Lang und spitz, für den Auftritt.', d: 'M24 170 L24 92 C24 62 44 22 50 2 C56 22 76 62 76 92 L76 170 Q50 196 24 170 Z' },
  { name: 'Ballerina', line: 'Gerade Seiten, flache Spitze.', d: 'M22 170 L22 72 L35 14 L65 14 L78 72 L78 170 Q50 196 22 170 Z' },
  { name: 'Square', line: 'Gerade Kante, die klassische Form.', d: 'M22 170 L22 30 Q22 24 28 24 L72 24 Q78 24 78 30 L78 170 Q50 196 22 170 Z' },
];

const tabLabels: Record<string, string> = {
  manikuere: 'Maniküre',
  modellage: 'Gel-X und Modellage',
  'press-ons': 'Press-Ons',
  nailart: 'Nailart',
};

// Portfolio erscheint erst, wenn echte Fotos unter public/images/portfolio/ liegen.
const photos = portfolio.filter((p) => fs.existsSync(path.join(process.cwd(), 'public', p.image)));
const showWork = photos.length >= 3;

const hours = site.openingHours.filter((h) => !h.hours.includes('PLATZHALTER'));
const hasPhone = !site.phone.includes('PLATZHALTER');
const hasMail = !site.email.includes('PLATZHALTER');
---

<BaseLayout title={title} description={description} home>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 id="hero-title">Schöne Nägel, gesunder Naturnagel.</h1>
        <p class="lead">Gel&#8209;X, Modellage und Maniküre von Vera, MMA-frei in March.</p>
        <div class="hero__actions">
          <a class="btn" href="#termin">Termin anfragen</a>
          <a class="link" href="#preise">Zu den Preisen</a>
        </div>
      </div>
      <figure class="claw-field" aria-hidden="true">
        <svg viewBox="0 0 640 560" preserveAspectRatio="xMidYMid slice" focusable="false">
          <rect class="f-rose" x="0" y="0" width="250" height="560" rx="16" />
          <rect class="f-gold" x="262" y="0" width="378" height="300" rx="16" />
          <rect class="f-blush" x="262" y="312" width="183" height="248" rx="16" />
          <rect class="f-oak" x="457" y="312" width="183" height="248" rx="16" />
          <g transform="rotate(-20 300 250)">
            <rect class="f-cut" x="196" y="40" width="22" height="430" rx="11" />
            <rect class="f-cut" x="262" y="10" width="22" height="470" rx="11" />
            <rect class="f-cut" x="328" y="50" width="22" height="400" rx="11" />
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <section class="services" id="leistungen" aria-labelledby="services-title">
    <div class="container services__grid">
      <h2 id="services-title">Was Vera für Ihre Nägel tut</h2>
      <dl class="rows">
        {
          services.map((s) => (
            <div class="rows__item">
              <dt>{s.name}</dt>
              <dd>{s.line}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="shapes" aria-labelledby="shapes-title">
    <div class="container">
      <h2 id="shapes-title">Vier Formen, eine davon Ihre</h2>
      <ul class="shapes__grid">
        {
          shapes.map((s) => (
            <li class="shape">
              <svg class="shape__nail" viewBox="0 0 100 200" aria-hidden="true" focusable="false">
                <path d={s.d} />
              </svg>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="prices" id="preise" aria-labelledby="prices-title">
    <div class="container">
      <div class="prices__head">
        <h2 id="prices-title">Preise und Dauer</h2>
        <p class="prices__note">Richtpreise vor der Eröffnung. Die endgültige Liste folgt.</p>
      </div>
      <div class="switch" data-switch>
        <div class="tabs" role="tablist" aria-label="Preiskategorie">
          {
            pricingCategories.map((c, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${c.slug}`}
                aria-controls={`panel-${c.slug}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {tabLabels[c.slug] ?? c.title}
              </button>
            ))
          }
        </div>
        {
          pricingCategories.map((c) => (
            <section class="panel" role="tabpanel" id={`panel-${c.slug}`} aria-labelledby={`tab-${c.slug}`}>
              <h3 class="panel__title">{c.title}</h3>
              <table class="price-table">
                <thead>
                  <tr>
                    <th scope="col">Leistung</th>
                    <th scope="col">Dauer</th>
                    <th scope="col" class="num">Preis</th>
                  </tr>
                </thead>
                <tbody>
                  {c.items.map((it) => (
                    <tr>
                      <th scope="row">
                        {it.name}
                        {it.description && <span class="price-table__desc">{it.description}</span>}
                      </th>
                      <td>{it.duration ?? ''}</td>
                      <td class="num">{it.price}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="studio" id="studio" aria-labelledby="studio-title">
    <div class="container studio__grid">
      <div class="studio__statement">
        <h2 id="studio-title">Kein MMA. Gel&#8209;X wird geklebt, nicht gefräst.</h2>
        <p class="lead">Vera arbeitet so, dass Ihr eigener Nagel darunter gesund bleibt.</p>
      </div>
      <div class="studio__certs">
        <h3>Geschult an der Lynis Nailacademy</h3>
        <ul class="certs">
          {certificates.map((c) => <li>{c.title}</li>)}
        </ul>
        <p class="certs__by">Bei Evelyn Gerz und Milla Spät</p>
      </div>
    </div>
  </section>

  {
    showWork && (
      <section class="work" aria-labelledby="work-title">
        <div class="container">
          <h2 id="work-title">Sets aus dem Studio</h2>
          <ul class="work__grid">
            {photos.slice(0, 6).map((p) => (
              <li>
                <figure class="work__item">
                  <img src={withBase(p.image)} alt={p.alt} loading="lazy" decoding="async" width="1200" height="1500" />
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="visit" id="termin" aria-labelledby="visit-title">
    <div class="container visit__grid">
      <div class="visit__facts">
        <h2 id="visit-title">Termin anfragen in March</h2>
        <dl class="facts">
          <div>
            <dt>Adresse</dt>
            <dd>
              {site.address.street}<br />{site.address.zip} {site.address.city}<br />
              <a class="link" href={site.address.mapsLinkHref} rel="noopener">Route in Google Maps</a>
            </dd>
          </div>
          <div>
            <dt>Öffnungszeiten</dt>
            <dd>
              {
                hours.length > 1 ? (
                  <ul class="hours">
                    {hours.map((h) => (
                      <li><span>{h.day}</span> <span>{h.hours}</span></li>
                    ))}
                  </ul>
                ) : (
                  <span class="fill" data-fill="hours">Öffnungszeiten folgen zur Eröffnung</span>
                )
              }
            </dd>
          </div>
          <div>
            <dt>Kontakt</dt>
            <dd>
              {hasPhone ? <a class="link" href={site.phoneHref}>{site.phone}</a> : <span class="fill" data-fill="phone">Telefonnummer folgt</span>}
              {hasMail && <><br /><a class="link" href={site.emailHref}>{site.email}</a></>}
            </dd>
          </div>
        </dl>
        <p class="visit__area">Für Kundinnen aus March, Umkirch, Hugstetten, Bötzingen, Gundelfingen und Freiburg.</p>
      </div>

      <form class="booking" data-endpoint="" novalidate>
        <div class="field">
          <label for="f-name">Ihr Name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-contact">Telefon oder E-Mail</label>
          <input id="f-contact" name="contact" type="text" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="f-service">Leistung</label>
          <select id="f-service" name="service">
            {services.map((s) => <option>{s.name}</option>)}
            <option>Noch unsicher, bitte beraten</option>
          </select>
        </div>
        <div class="field">
          <label for="f-when">Wunschtermin</label>
          <input id="f-when" name="when" type="text" placeholder="z. B. Dienstagnachmittag" />
        </div>
        <div class="field field--wide">
          <label for="f-note">Nachricht</label>
          <textarea id="f-note" name="note" rows="3"></textarea>
        </div>
        <div class="booking__foot">
          <button class="btn" type="submit">Anfrage senden</button>
          <p class="booking__help" id="booking-help" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>('[data-switch]').forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
      const select = (i: number, focus = false) => {
        tabs.forEach((t, j) => {
          t.setAttribute('aria-selected', String(i === j));
          t.tabIndex = i === j ? 0 : -1;
          panels[j].hidden = i !== j;
        });
        if (focus) tabs[i].focus();
      };
      root.classList.add('is-ready');
      select(0);
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
          if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
        });
      });
    });

    document.querySelectorAll<HTMLFormElement>('form[data-endpoint]').forEach((form) => {
      const help = form.querySelector<HTMLElement>('[aria-live]')!;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[required]'));
        fields.forEach((f) => f.toggleAttribute('aria-invalid', !f.checkValidity()));
        const bad = fields.find((f) => !f.checkValidity());
        if (bad) {
          bad.setAttribute('aria-describedby', help.id);
          help.textContent = 'Bitte Name und Telefon oder E-Mail angeben, damit Vera sich melden kann.';
          bad.focus();
          return;
        }
        if (!form.dataset.endpoint) {
          help.textContent = 'Es wurde nichts gesendet: das Formular ist noch nicht angeschlossen.';
          return;
        }
        fetch(form.dataset.endpoint, { method: 'POST', body: new FormData(form) })
          .then((r) => {
            help.textContent = r.ok
              ? 'Danke. Vera meldet sich mit einem Terminvorschlag.'
              : 'Das hat nicht geklappt. Bitte in einer Minute noch einmal versuchen.';
          })
          .catch(() => {
            help.textContent = 'Das hat nicht geklappt. Bitte in einer Minute noch einmal versuchen.';
          });
      });
    });
  </script>
</BaseLayout>
