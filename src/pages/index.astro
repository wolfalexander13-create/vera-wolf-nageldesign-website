---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { pricingCategories, pricingIntro, pricingValidFrom } from '../data/pricing';
import { certificates } from '../data/certificates';
import { portfolio, type PortfolioItem } from '../data/portfolio';
import { withBase } from '../utils/url';

const title = 'WolfClawz Nail Design by Vera, Nageldesign in March-Neuershausen';
const description =
  'Naturnagelverstärkung, Gel- und Acrylgel-Modellage und Nailart im Home Studio von Vera in March-Neuershausen bei Freiburg.';

const offers = [
  { name: 'Naturnagelverstärkung', line: 'Ich stärke und schütze deine eigenen Nägel, ohne Verlängerung.' },
  { name: 'Gel-Modellage mit Verlängerung', line: 'Mit Schablone, Tipps oder Dual Form, von Länge S bis Überlänge.' },
  { name: 'Acrylgel', line: 'Modellage mit Acrylgel, mit oder ohne Verlängerung.' },
  { name: 'Nailart', line: 'Von French und Cat-Eye bis Handmalerei und 3D-Gel.' },
  { name: 'Hochzeitsnägel', line: 'Abgestimmt auf dein Kleid, deinen Brautstrauß und dich.' },
];

// Fotos erscheinen nur, wenn die Datei unter public/ wirklich existiert.
const onDisk = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
const photos = portfolio.filter((p) => onDisk(p.image));
const byId = (id: string) => photos.find((p) => p.id === id);
const heroPhoto = photos.find((p) => p.hero);

// Die Formen, die Vera anbietet, jeweils mit einem Foto ihrer Arbeit.
// Neues Foto: in src/data/portfolio.ts eintragen und die id hier setzen.
const shapes: { name: string; line: string; photo?: PortfolioItem }[] = [
  { name: 'Square', line: 'Gerade Seiten, gerade Kante.', photo: byId('square-grapefruit') },
  { name: 'Mandel', line: 'Schmal zulaufend.', photo: byId('mandel-orange-blueten') },
  { name: 'Oval', line: 'Rund und natürlich.', photo: byId('oval-cateye-kupfer') },
];
const specialPhoto = byId('stiletto-pink-herzen');
const shapeIds = new Set([...shapes.map((s) => s.photo?.id), specialPhoto?.id]);
const gallery = photos
  .filter((p) => !p.hero && p.featured !== false && !p.section && !shapeIds.has(p.id))
  .slice(0, 6);
const seasonal = photos.filter((p) => p.section === 'saisonal');

const portrait = '/images/portrait/vera-wolf.jpg';
const hasPortrait = onDisk(portrait);

// Studio-Fotos: Dateien unter public/images/studio/ ablegen, sie erscheinen automatisch.
const studioDir = path.join(process.cwd(), 'public', 'images', 'studio');
const studioPhotos = fs.existsSync(studioDir)
  ? fs.readdirSync(studioDir).filter((f) => /\.(jpe?g|png|webp)$/i.test(f)).sort().slice(0, 2)
  : [];

const hasPhone = !site.phone.includes('PLATZHALTER');
const hasMail = !site.email.includes('PLATZHALTER');
const hasInstagram = site.instagramHref.startsWith('http');
---

<BaseLayout title={title} description={description} home>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 id="hero-title">Schöne Nägel, gesunder Naturnagel.</h1>
        <p class="lead">Ich modelliere deine Nägel mit Gel und Acrylgel, in Neuershausen.</p>
        <div class="hero__actions">
          <a class="btn" href="#termin">Termin anfragen</a>
          <a class="link" href="#preise">Zu den Preisen</a>
        </div>
      </div>
      <figure class="claw-field">
        {
          heroPhoto && (
            <img
              src={withBase(heroPhoto.image)}
              alt={heroPhoto.alt}
              width={heroPhoto.width}
              height={heroPhoto.height}
              style={`object-position: ${heroPhoto.focus ?? '50% 50%'}`}
              fetchpriority="high"
              decoding="async"
            />
          )
        }
        <svg class="claw-field__marks" viewBox="0 0 640 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
          <g transform="rotate(-20 120 140)">
            <rect class="f-cut" x="60" y="-120" width="22" height="330" rx="11" />
            <rect class="f-cut" x="122" y="-150" width="22" height="370" rx="11" />
            <rect class="f-cut" x="184" y="-110" width="22" height="300" rx="11" />
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <section class="services" id="angebot" aria-labelledby="services-title">
    <div class="container services__grid">
      <div class="services__head">
        <h2 id="services-title">Das biete ich dir an</h2>
        <p class="services__note">Ich verwende nur Produkte, die der Kosmetikverordnung entsprechen.</p>
      </div>
      <dl class="rows">
        {
          offers.map((s) => (
            <div class="rows__item">
              <dt>{s.name}</dt>
              <dd>{s.line}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="shapes" id="formen" aria-labelledby="shapes-title">
    <div class="container">
      <h2 id="shapes-title">Diese Nagelformen biete ich an</h2>
      <ul class="shapes__grid">
        {
          shapes.map((s) => (
            <li class="shape">
              <div class="shape__frame" data-slot={`form-${s.name.toLowerCase()}`} data-alt={`Foto einer ${s.name}-Modellage`}>
                {s.photo && (
                  <img
                    src={withBase(s.photo.image)}
                    alt={s.photo.alt}
                    width={s.photo.width}
                    height={s.photo.height}
                    style={`object-position: ${s.photo.focus ?? '50% 50%'}`}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
            </li>
          ))
        }
        <li class="shape shape--special">
          <div class="shape__frame">
            {specialPhoto && (
              <img
                src={withBase(specialPhoto.image)}
                alt={specialPhoto.alt}
                width={specialPhoto.width}
                height={specialPhoto.height}
                style={`object-position: ${specialPhoto.focus ?? '50% 50%'}`}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <h3>Sonderformen</h3>
          <p>Stiletto, Edge und russische Mandel auf Anfrage. Dafür suche ich gerade <a class="link" href="#termin">Modelle</a>.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="technique" aria-labelledby="technique-title">
    <div class="container technique__grid">
      <div class="technique__text">
        <h2 id="technique-title">Meine Technik</h2>
        <p class="lead">
          Ich arbeite sowohl im Old School als auch im New Style. Welche Statik ich wähle, hängt von deinem
          Naturnagel, deinem Wunsch und der Nagelform ab.
        </p>
        <p>So halten deine Nägel länger und sehen schöner aus.</p>
      </div>
      <dl class="technique__styles">
        <div>
          <dt>New Style</dt>
          <dd>Bei einem ausgeprägten Naturtunnel arbeite ich einen Square zum Beispiel im New Style.</dd>
        </div>
        <div>
          <dt>Old School</dt>
          <dd>Bei einem flachen Tunnel und einem platten Nagelbett setze ich eine Mandel eher im Old School um.</dd>
        </div>
      </dl>
    </div>
  </section>

  {
    gallery.length >= 6 && (
      <section class="work" id="arbeiten" aria-labelledby="work-title">
        <div class="container">
          <div class="work__head">
            <h2 id="work-title">Frisch aus meinem Studio</h2>
            {hasInstagram && <a class="link" href={site.instagramHref} target="_blank" rel="me noopener">Mehr auf Instagram<span class="visually-hidden"> (öffnet in neuem Tab)</span></a>}
          </div>
          <ul class="work__grid">
            {gallery.map((p, i) => (
              <li class={i === 0 ? 'work__lead' : undefined}>
                <figure class="work__item">
                  <div class="work__frame">
                    <img
                      src={withBase(p.image)}
                      alt={p.alt}
                      width={p.width}
                      height={p.height}
                      style={`object-position: ${p.focus ?? '50% 50%'}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption>{p.caption}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="prices" id="preise" aria-labelledby="prices-title">
    <div class="container">
      <div class="prices__head">
        <h2 id="prices-title">Preise und Dauer</h2>
        <p class="prices__note">{pricingIntro}</p>
      </div>
      <div class="switch" data-switch>
        <div class="tabs" role="tablist" aria-label="Preiskategorie">
          {
            pricingCategories.map((c, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${c.slug}`}
                aria-controls={`panel-${c.slug}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {c.tab}
              </button>
            ))
          }
        </div>
        {
          pricingCategories.map((c) => (
            <section class="panel" role="tabpanel" id={`panel-${c.slug}`} aria-labelledby={`tab-${c.slug}`}>
              <h3 class="panel__title">{c.title}</h3>
              <table class="price-table">
                <thead>
                  <tr>
                    <th scope="col">Leistung</th>
                    <th scope="col">Dauer</th>
                    <th scope="col" class="num">Preis</th>
                  </tr>
                </thead>
                <tbody>
                  {c.items.map((it) => (
                    <tr>
                      <th scope="row">
                        {it.name}
                        {it.description && <span class="price-table__desc">{it.description}</span>}
                        {it.note && <span class="price-table__desc">{it.note}</span>}
                      </th>
                      <td>{it.duration ?? ''}</td>
                      <td class="num">{it.price}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          ))
        }
      </div>
      <p class="prices__valid">Gültig ab {pricingValidFrom}.</p>
    </div>
  </section>

  {
    seasonal.length > 0 && (
      <section class="seasonal" aria-labelledby="seasonal-title">
        <div class="container seasonal__grid">
          <div class="seasonal__head">
            <h2 id="seasonal-title">Saisonale Nägel</h2>
            <p class="lead">Zu Halloween, Weihnachten und jeder Jahreszeit dazwischen.</p>
          </div>
          {seasonal.map((p) => (
            <figure class="work__item seasonal__item">
              <div class="work__frame">
                <img
                  src={withBase(p.image)}
                  alt={p.alt}
                  width={p.width}
                  height={p.height}
                  style={`object-position: ${p.focus ?? '50% 50%'}`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <section class="studio" id="ueber-mich" aria-labelledby="about-title">
    <div class="container studio__grid">
      {
        hasPortrait && (
          <figure class="portrait">
            <img src={withBase(portrait)} alt="Vera Wolf in rosa Schürze" width="560" height="700" loading="lazy" decoding="async" />
          </figure>
        )
      }
      <div class="studio__statement">
        <h2 id="about-title">Hallo, ich bin Vera.</h2>
        <p class="lead">
          Vor 17 Jahren habe ich angefangen, mir selbst die Nägel zu machen, um Geld zu sparen. Aus der Not wurde
          eine Leidenschaft, und aus dem Hobby ist mein Beruf geworden.
        </p>
        <p>Seit 2024 bin ich zertifiziert und jeden Tag froh, so einen schönen Beruf zu haben.</p>
        <p>Danke an meinen Mann, der mich auf diesem Weg unterstützt.</p>
      </div>
      <div class="studio__certs">
        <h3>Geschult an der Lynis Nailacademy</h3>
        <ul class="certs">
          {certificates.map((c) => <li>{c.title}</li>)}
        </ul>
        <p class="certs__by">Bei Evelyn Gerz und Milla Spät</p>
      </div>
    </div>
  </section>

  <section class="visit" id="termin" aria-labelledby="visit-title">
    <div class="container visit__grid">
      <div class="visit__facts">
        <h2 id="visit-title">Mein Home Studio in Neuershausen</h2>
        {
          studioPhotos.length > 0 ? (
            <div class="studio-photos">
              {studioPhotos.map((f) => (
                <figure class="studio-photos__item">
                  <img src={withBase(`/images/studio/${f}`)} alt="Einblick in Veras Home Studio" loading="lazy" decoding="async" width="1200" height="900" />
                </figure>
              ))}
            </div>
          ) : (
            <p><span class="fill" data-fill="studio">Fotos vom Home Studio folgen</span></p>
          )
        }
        <dl class="facts">
          <div>
            <dt>Adresse</dt>
            <dd>
              {site.address.street}<br />{site.address.zip} {site.address.city}<br />
              <a class="link" href={site.address.mapsLinkHref} target="_blank" rel="noopener">Route in Google Maps<span class="visually-hidden"> (öffnet in neuem Tab)</span></a>
            </dd>
          </div>
          <div>
            <dt>Termine</dt>
            <dd>Nach Vereinbarung</dd>
          </div>
          <div>
            <dt>Kontakt</dt>
            <dd>
              {hasInstagram && <a class="link" href={site.instagramHref} target="_blank" rel="me noopener">@WolfClawz.byVera auf Instagram<span class="visually-hidden"> (öffnet in neuem Tab)</span></a>}
              {hasPhone && <><br /><a class="link" href={site.phoneHref}>{site.phone}</a></>}
              {hasMail && <><br /><a class="link" href={site.emailHref}>{site.email}</a></>}
            </dd>
          </div>
        </dl>
      </div>

      <form class="booking" data-endpoint="" novalidate>
        <div class="field">
          <label for="f-name">Dein Name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-contact">Telefon oder E-Mail</label>
          <input id="f-contact" name="contact" type="text" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="f-service">Was möchtest du?</label>
          <select id="f-service" name="service">
            <option>Naturnagelverstärkung</option>
            <option>Neumodellage</option>
            <option>Refill</option>
            <option>Nailart</option>
            <option>Hochzeitsnägel</option>
            <option>Sonderform</option>
            <option>Modell für Stiletto oder russische Mandel</option>
            <option>Entfernung Fremdarbeit</option>
            <option>Ich bin noch unsicher</option>
          </select>
        </div>
        <div class="field">
          <label for="f-when">Wunschtermin</label>
          <input id="f-when" name="when" type="text" placeholder="z. B. Dienstagnachmittag" />
        </div>
        <div class="field field--wide">
          <label for="f-note">Nachricht</label>
          <textarea id="f-note" name="note" rows="3"></textarea>
        </div>
        <div class="booking__foot">
          <button class="btn" type="submit">Anfrage senden</button>
          <p class="booking__help" id="booking-help" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>('[data-switch]').forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
      const select = (i: number, focus = false) => {
        tabs.forEach((t, j) => {
          t.setAttribute('aria-selected', String(i === j));
          t.tabIndex = i === j ? 0 : -1;
          panels[j].hidden = i !== j;
        });
        if (focus) tabs[i].focus();
      };
      root.classList.add('is-ready');
      select(0);
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
          if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
        });
      });
    });

    document.querySelectorAll<HTMLFormElement>('form[data-endpoint]').forEach((form) => {
      const help = form.querySelector<HTMLElement>('[aria-live]')!;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[required]'));
        fields.forEach((f) => f.toggleAttribute('aria-invalid', !f.checkValidity()));
        const bad = fields.find((f) => !f.checkValidity());
        if (bad) {
          bad.setAttribute('aria-describedby', help.id);
          help.textContent = 'Bitte gib deinen Namen und Telefon oder E-Mail an, damit ich mich melden kann.';
          bad.focus();
          return;
        }
        if (!form.dataset.endpoint) {
          help.textContent = 'Es wurde nichts gesendet: das Formular ist noch nicht angeschlossen. Schreib mir gern auf Instagram.';
          return;
        }
        fetch(form.dataset.endpoint, { method: 'POST', body: new FormData(form) })
          .then((r) => {
            help.textContent = r.ok
              ? 'Danke. Ich melde mich bei dir mit einem Terminvorschlag.'
              : 'Das hat nicht geklappt. Bitte versuch es in einer Minute noch einmal.';
          })
          .catch(() => {
            help.textContent = 'Das hat nicht geklappt. Bitte versuch es in einer Minute noch einmal.';
          });
      });
    });
  </script>
</BaseLayout>
