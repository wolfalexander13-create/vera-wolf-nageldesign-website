---
import SiteHeader from '../components/clawz/SiteHeader.astro';
import SiteFooter from '../components/clawz/SiteFooter.astro';
import { site } from '../data/site';
import { withBase } from '../utils/url';
import '../styles/clawz.css';

interface Props {
  title: string;
  description: string;
  /** JSON-LD Objekte, die zusätzlich zum globalen NailSalon-Schema eingebunden werden. */
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
  home?: boolean;
}

const { title, description, structuredData = [], noindex = false, home = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(withBase('/images/og/og-cover.jpg'), Astro.site);
const isSet = (v: string) => v && !v.includes('PLATZHALTER');

const localBusinessSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'NailSalon',
  name: site.fullName,
  description: site.positioning,
  url: String(Astro.site),
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  areaServed: site.serviceArea,
};
if (isSet(site.phone)) localBusinessSchema.telephone = site.phone;
if (site.instagramHref.startsWith('http')) localBusinessSchema.sameAs = [site.instagramHref];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Schriften laut Design System: Cormorant Garamond (Überschriften) und Jost (Text) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=Jost:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />
    {
      structuredData.map((schema) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <SiteHeader home={home} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
