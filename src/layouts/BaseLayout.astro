---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** JSON-LD Objekte, die zusätzlich zum globalen LocalBusiness-Schema eingebunden werden. */
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, structuredData = [], noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/images/og/og-cover.jpg', Astro.site);

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'NailSalon',
  name: 'Vera Wolf Nageldesign',
  description:
    'Premium-Nagelstudio in March bei Freiburg im Breisgau: russische Maniküre, präzise Modellage und Naturnagelpflege ohne MMA.',
  image: String(new URL('/images/og/og-cover.jpg', Astro.site)),
  url: String(Astro.site),
  telephone: '[PLATZHALTER: Telefonnummer]',
  priceRange: '€€–€€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Landstraße 39',
    postalCode: '79232',
    addressLocality: 'March-Hugstetten',
    addressRegion: 'Baden-Württemberg',
    addressCountry: 'DE',
  },
  areaServed: [
    'March',
    'Umkirch',
    'Hugstetten',
    'Bötzingen',
    'Gundelfingen',
    'Freiburg im Breisgau',
  ],
  openingHoursSpecification: [
    '[PLATZHALTER: Öffnungszeiten strukturiert ergänzen, sobald final]',
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vera Wolf Nageldesign" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts: Fraunces (Display) + Manrope (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org: NailSalon / LocalBusiness -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />
    {
      structuredData.map((schema) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
