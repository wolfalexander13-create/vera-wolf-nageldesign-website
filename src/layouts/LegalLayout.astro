---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;
---

<BaseLayout title={title} description={description} noindex>
  <article class="legal section-pad">
    <div class="wrap wrap--narrow">
      <a class="legal__back" href="/">&larr; Zurück zur Startseite</a>
      <h1>{heading}</h1>
      <div class="legal__content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal h1 {
    font-size: clamp(2rem, 4vw, 2.6rem);
    margin-bottom: 2rem;
  }

  .legal__back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.88rem;
    color: var(--color-primary);
    text-decoration: none;
  }

  .legal__back:hover {
    text-decoration: underline;
  }

  .legal__content {
    color: var(--color-ink-soft);
    line-height: 1.75;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .legal__content :global(h2) {
    font-size: 1.3rem;
    color: var(--color-ink);
    margin-top: 1rem;
  }

  .legal__content :global(p) {
    font-size: 0.98rem;
  }

  .legal__content :global(ul) {
    list-style: disc;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .legal__content :global(a) {
    color: var(--color-primary);
  }
</style>
