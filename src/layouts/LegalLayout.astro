---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;
---

<BaseLayout title={title} description={description} noindex>
  <article class="legal">
    <div class="container legal__inner">
      <a class="legal__back" href={withBase('/')}>Zurück zur Startseite</a>
      <h1>{heading}</h1>
      <div class="legal__content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
